+        tickers = {"sp500": ["AAPL", "JPM"], "dow": ["AAPL", "GONE"], "nasdaq100": ["MSFT"]}
+        records = []
+        for ticker in tickers[index]:
+            records.append(_universe_row(index, ticker))
+        return pd.DataFrame(records, columns=iu.UNIVERSE_COLUMNS)
